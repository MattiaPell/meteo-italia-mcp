{
  "name": "meteo-italia-mcp-server",
  "version": "1.0.0",
  "description": "MCP server + debug web page wrapping Open-Meteo and Italian weather data APIs used by the meteo-italia skill",
  "type": "module",
  "bin": {
    "meteo-italia-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run --config ./vitest.config.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"src/**/*.ts\" --ignore-path .prettierignore"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "fast-xml-parser": "^5.11.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
